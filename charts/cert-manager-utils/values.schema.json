{
    "$schema": "http://json-schema.org/schema#",
    "type": "object",
    "properties": {
        "certificates": {
            "type": "object",
            "properties": {
                "apiVersion": {
                    "type": "string"
                },
                "commonAnnotations": {
                    "type": "object"
                },
                "commonLabels": {
                    "type": "object"
                },
                "objects": {
                    "type": "object",
                    "patternProperties": {
                        "^[a-zA-Z0-9-_]+$": {
                            "type": "object",
                            "properties": {
                                "commonName": {
                                    "type": "string"
                                },
                                "dnsNames": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "ipAddresses": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "uris": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "issuerRef": {
                                    "type": "object",
                                    "required": [
                                        "kind",
                                        "name"
                                    ],
                                    "properties": {
                                        "kind": {
                                            "type": "string",
                                            "enum": [
                                                "Issuer",
                                                "ClusterIssuer"
                                            ]
                                        },
                                        "name": {
                                            "type": "string"
                                        },
                                        "group": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "issuers": {
            "type": "object",
            "properties": {
                "apiVersion": {
                    "type": "string"
                },
                "commonAnnotations": {
                    "type": "object"
                },
                "commonLabels": {
                    "type": "object"
                },
                "objects": {
                    "type": "object",
                    "patternProperties": {
                        "^[a-zA-Z0-9-_]+$": {
                            "type": "object",
                            "required": [
                                "kind",
                                "spec"
                            ],
                            "properties": {
                                "kind": {
                                    "type": "string",
                                    "enum": [
                                        "Issuer",
                                        "ClusterIssuer"
                                    ]
                                },
                                "spec": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "nameOverride": {
            "type": "string"
        }
    }
}